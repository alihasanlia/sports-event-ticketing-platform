# Auto detect text files and perform LF normalization
* text=auto

# Source code files - always use LF
*.java text eol=lf
*.kt text eol=lf
*.groovy text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.gradle text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf

# Shell scripts - must use LF
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf

# Batch files - must use CRLF (Windows)
*.bat text eol=crlf
*.cmd text eol=crlf

# Maven Wrapper
.mvn/wrapper/maven-wrapper.jar binary
mvnw text eol=lf
mvnw.cmd text eol=crlf

# Binary files
*.jar binary
*.war binary
*.ear binary
*.zip binary
*.tar.gz binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.class binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.db binary
*.h2.db binary
*.mv.db binary

# OS files
.DS_Store binary
Thumbs.db binary